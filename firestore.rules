rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function dailyKeys() {
      return [
        'dia', 'visitas', 'mobile', 'desktop', 'demo_barbearia',
        'demo_restaurante', 'demo_salao', 'demo_dentista', 'demo_pet',
        'demo_cafe', 'demo_ginasio', 'demo_confeitaria', 'demo_floricultura'
      ];
    }

    function validInitialDemoCounters(data) {
      return (!data.keys().hasAny(['demo_barbearia']) || data.demo_barbearia == 1)
        && (!data.keys().hasAny(['demo_restaurante']) || data.demo_restaurante == 1)
        && (!data.keys().hasAny(['demo_salao']) || data.demo_salao == 1)
        && (!data.keys().hasAny(['demo_dentista']) || data.demo_dentista == 1)
        && (!data.keys().hasAny(['demo_pet']) || data.demo_pet == 1)
        && (!data.keys().hasAny(['demo_cafe']) || data.demo_cafe == 1)
        && (!data.keys().hasAny(['demo_ginasio']) || data.demo_ginasio == 1)
        && (!data.keys().hasAny(['demo_confeitaria']) || data.demo_confeitaria == 1)
        && (!data.keys().hasAny(['demo_floricultura']) || data.demo_floricultura == 1);
    }

    function validDailyCreate(dia) {
      let data = request.resource.data;
      return dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.keys().hasOnly(dailyKeys())
        && data.dia == dia
        && ((data.keys().hasAll(['visitas'])
          && data.visitas == 1
          && ((data.get('mobile', 0) == 1 && data.get('desktop', 0) == 0)
            || (data.get('mobile', 0) == 0 && data.get('desktop', 0) == 1)))
          || (!data.keys().hasAny(['visitas', 'mobile', 'desktop'])
            && data.keys().hasAny([
              'demo_barbearia', 'demo_restaurante', 'demo_salao', 'demo_dentista',
              'demo_pet', 'demo_cafe', 'demo_ginasio', 'demo_confeitaria',
              'demo_floricultura'
            ])))
        && validInitialDemoCounters(data);
    }

    function incrementedByOne(field) {
      return request.resource.data.get(field, 0) == resource.data.get(field, 0) + 1;
    }

    function validDailyUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.keys().hasOnly(dailyKeys())
        && request.resource.data.dia == resource.data.dia
        && changed.hasOnly([
          'visitas', 'mobile', 'desktop', 'demo_barbearia', 'demo_restaurante',
          'demo_salao', 'demo_dentista', 'demo_pet', 'demo_cafe',
          'demo_ginasio', 'demo_confeitaria', 'demo_floricultura'
        ])
        && changed.size() <= 2
        && (!changed.hasAny(['visitas']) || incrementedByOne('visitas'))
        && (!changed.hasAny(['mobile']) || incrementedByOne('mobile'))
        && (!changed.hasAny(['desktop']) || incrementedByOne('desktop'))
        && (!changed.hasAny(['demo_barbearia']) || incrementedByOne('demo_barbearia'))
        && (!changed.hasAny(['demo_restaurante']) || incrementedByOne('demo_restaurante'))
        && (!changed.hasAny(['demo_salao']) || incrementedByOne('demo_salao'))
        && (!changed.hasAny(['demo_dentista']) || incrementedByOne('demo_dentista'))
        && (!changed.hasAny(['demo_pet']) || incrementedByOne('demo_pet'))
        && (!changed.hasAny(['demo_cafe']) || incrementedByOne('demo_cafe'))
        && (!changed.hasAny(['demo_ginasio']) || incrementedByOne('demo_ginasio'))
        && (!changed.hasAny(['demo_confeitaria']) || incrementedByOne('demo_confeitaria'))
        && (!changed.hasAny(['demo_floricultura']) || incrementedByOne('demo_floricultura'));
    }

    match /pedidos/{pedidoId} {
      allow create: if request.resource.data.keys().hasOnly([
        'nome', 'email', 'telefone', 'tipoNegocio', 'plano', 'mensagem',
        'estado', 'origem', 'notaInterna', 'criadoEm'
      ])
      && request.resource.data.nome is string
      && request.resource.data.email is string
      && request.resource.data.mensagem is string
      && request.resource.data.estado == 'novo'
      && request.resource.data.origem == 'site'
      && request.resource.data.notaInterna == '';
      allow read, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /planos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /exemplos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faq/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /configuracoes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /clientes/{id} {
      allow read, write: if isAdmin();
    }
    match /estatisticas_diarias/{dia} {
      allow read: if isAdmin();
      allow create: if validDailyCreate(dia);
      allow update: if validDailyUpdate();
      allow delete: if isAdmin();
    }
    match /estatisticas/visitas {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['total']) && request.resource.data.total == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total'])
        && request.resource.data.total == resource.data.total + 1;
      allow delete: if isAdmin();
    }
  }
}